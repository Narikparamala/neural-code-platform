# Supabase Configuration (browser bundle)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: point a static mirror at the Vercel email API
# VITE_API_BASE=https://neural-code-platform.vercel.app

# ---------------------------------------------------------------------------
# Server-side only (Vercel Functions -> Project Settings -> Environment)
# Never expose these with a VITE_ prefix.
# ---------------------------------------------------------------------------

# Supabase project + service role key (bypasses RLS; server-only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key
ADMIN_EMAIL=you@example.com
SITE_URL=https://your-site.vercel.app

# Postal address required in the footer of every newsletter email
POSTAL_ADDRESS=Your city, postal code, country

# Option A: Brevo (preferred when the account is phone-verified)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME=CosmicSpirit0

# Option B: Google Apps Script relay (free, sends as your Gmail, ~100/day)
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=

# Safety cap per send (Gmail free ~100/day, Brevo free ~300/day)
MAX_EMAILS_PER_SEND=95
